# Copy to .env (gitignored) and edit. Used by compose.yaml. Keep comments on their own lines.
# REQUIRED: public URL, no trailing slash (e.g. https://bookmarks.example.com)
BM_BASE_URL=http://localhost:8080
# Host address:port of the web container; put your TLS reverse proxy in front of it
BM_PORT=127.0.0.1:8080
BM_MAIL_FROM=bookmarks@localhost
# SMTP for login mails. Empty host => mails are only appended to data/mail.log in the volume. Secure: tls|ssl|none
BM_SMTP_HOST=
BM_SMTP_PORT=587
BM_SMTP_SECURE=tls
BM_SMTP_USER=
BM_SMTP_PASS=
# OpenRouter does the tagging and summaries (empty key = rules only). Models: comma-separated, empty = defaults from docker/config.php
BM_OPENROUTER_KEY=
BM_OPENROUTER_MODELS=
# OpenRouter calls per month
BM_OPENROUTER_CAP=3000
BM_YOUTUBE_API_KEY=
